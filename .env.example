# Root docker-compose.yml settings.
# Copy to .env and provide real values without committing that file.

# Required
PG_PASSWORD=
API_KEY=
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=

# Optional paths and host integration
FST_DATA_DIR=./fst-data
POSTGRES_DATA_DIR=./pg-data
DOCKER_GID=999
MIDI_ENCRYPTION_KEY=

# Optional public feature
FEATURE_APP_MANUAL=false

# Temporary, bounded browser interaction diagnostics ingestion.
CLIENT_TELEMETRY_ENABLED=false
