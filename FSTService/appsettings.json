{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "FSTService": "Debug",
      "FSTService.Api.ApiKeyAuthHandler": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss ",
        "UseUtcTimestamp": true
      }
    }
  },
  "Scraper": {
    "ScrapeInterval": "04:00:00",
    "WebRegistrationRetentionDays": 7,
    "RankHistorySnapshotMaxDegreeOfParallelism": 1,
    "DegreeOfParallelism": 512,
    "QueryLead": true,
    "QueryDrums": true,
    "QueryVocals": true,
    "QueryBass": true,
    "QueryProLead": true,
    "QueryProBass": true,
    "DataDirectory": "data",
    "DeviceAuthPath": "data/device-auth.json",
    "CHOptPath": "tools/CHOpt",
    "EnablePathGeneration": true,
    "EnableAutomaticPathGeneration": false,
    "PathGenerationParallelism": 4,
    "PathGenerationProfile": "chopt-fnf-ew0-s20-json-png-v1",
    "SongMachineDop": 32,
    "PostScrapeRefreshTimeout": "00:05:00",
    "RegisteredUserRefreshTimeout": "00:00:00",
    "RegisteredPlayerBandDiscoveryTimeout": "00:06:00",
    "RegisteredBandTargetedProcessingTimeout": "00:05:00",
    "RegisteredPlayerBandDiscoveryMaxLookupsPerPass": 80,
    "RegisteredBandProcessingMaxLookupsPerPass": 80,
    "RegistrationBackfillMode": "ForegroundEpicExclusive",
    "LeaderboardWriteMode": "DiskSpool",
    "OnlineWriteBatchPages": 64,
    "OnlineDbWriterConcurrency": 2,
    "BandExtractionParallelism": 8,
    "BandMembershipRebuildBatchSize": 2000,
    "EnableBandScraping": true,
    "ProxyUrls": [],
    "ExpectedProxyEndpointCount": 0,
    "ProxyMaxRequestsPerSecondPerEndpoint": 0,
    "ProxyMaxConcurrentRequestsPerEndpoint": 0,
    "ProxyDisableConnectionReuse": false,
    "ProxyUseCurlTransport": false,
    "ProxyCurlTempDirectory": "",
    "ControlUrls": [],
    "VpnProviders": [],
    "ContainerNames": [],
    "ProxyContainerSelfHealEnabled": false,
    "ProxyContainerRestartFailureThreshold": 1,
    "ProxyContainerRestartMinIntervalSeconds": 300,
    "ProxyContainerRestartCooldownSeconds": 90
  },
  "Features": {
    "WriteLegacyLiveLeaderboardDuringScrape": false,
    "WriteLegacyLiveLeaderboardSupplementalRows": true,
    "UseStoredSoloProjectionRanksForFilteredReads": false,
    "EnforceScopeCompletenessManifests": false,
    "RequireSuccessfulScrapeWriters": false,
    "EnforcePublicationCriticalPhases": false
  },

  "ClientTelemetry": {
    "Enabled": false,
    "MaxEventsPerBatch": 50,
    "MaxPayloadBytes": 65536
  },

  "ImprovementNotifications": {
    "Enabled": false,
    "Scope": "registered",
    "IncludePlayers": true,
    "IncludeBands": true,
    "IncludeSongEvents": true,
    "IncludeRankings": true,
    "PruneExpired": true,
    "RefreshSoloProjection": true,
    "RefreshAllSoloScopesWhenNoImpactedScopes": false,
    "CommandTimeoutSeconds": 0,
    "SoloProjectionCommandTimeoutSeconds": 0,
    "StaleAfterPublishedScrapes": 1,
    "StaleAfterHours": 24,
    "StalenessCheckInterval": "00:15:00"
  },

  "PublicationCommit": {
    "DrainTimeoutMilliseconds": 5000,
    "RetryDelayMilliseconds": 50,
    "RelationLockTimeoutMilliseconds": 500,
    "StatementTimeoutMilliseconds": 5000,
    "MaxExclusiveLockDurationMilliseconds": 5000,
    "StaleCommitIntentSeconds": 30,
    "ContentionRetryAttempts": 24,
    "ContentionRetryDelayMilliseconds": 250,
    "DefaultReadLeaseSeconds": 30,
    "ExportReadLeaseSeconds": 180,
    "AbandonedReadyGraceSeconds": 30,
    "WorkerHeartbeatFreshSeconds": 30,
    "PreparationLockTimeoutMilliseconds": 5000,
    "PreparationStatementTimeoutMilliseconds": 900000,
    "PreparationTransactionTimeoutMilliseconds": 1800000,
    "NotificationRecoveryRetrySeconds": 60
  },

  "BandRankHistory": {
    "Mode": "Disabled",
    "WriteMode": "V2Only",
    "UseLatestState": true,
    "UseNarrowHistory": true,
    "UseWideHistoryCompatibilityWrite": false,
    "ApiReadSource": "V2NarrowOnly",
    "CompactV3DuetsReadEnabled": true,
    "CompactV3TriosReadEnabled": true,
    "CompactV3QuadReadEnabled": true,
    "ChunkSize": 250000,
    "RangeChunkingEnabled": true,
    "MaxParallelChunks": 1,
    "CommandTimeoutSeconds": 0,
    "RetentionDays": 365,
    "SynchronousCommitOff": false,
    "CoalesceSameDaySnapshots": true,
    "MaxCatchupAgeHours": 24
  },

  "BandTeamRankings": {
    "WriteMode": "ComboBatched",
    "CommandTimeoutSeconds": 0,
    "AnalyzeStagingTable": false,
    "DisableSynchronousCommit": true,
    "OverlapRankHistorySnapshotsWithBandRankings": false
  },

  "DatabaseMaintenance": {
    "SkipCleanupWhenPressureDetected": true,
    "RankHistoryCleanupBatchSize": 5000,
    "RankHistoryCleanupMaxBatches": 1,
    "BandRankHistoryCleanupBatchSize": 5000,
    "BandRankHistoryCleanupMaxBatches": 1,
    "CleanupCommandTimeoutSeconds": 120,
    "ServiceLevelRetentionMaintenanceEnabled": true,
    "SnapshotRetentionRewriteEnabled": false,
    "SnapshotRetentionReportOnlyWhenDisabled": true,
    "SnapshotRetentionRollbackCompletedSnapshotsToKeep": 1,
    "SnapshotRetentionMaxPartitionsPerRun": 1,
    "SnapshotRetentionMinimumEstimatedPurgeBytes": 1073741824,
    "SnapshotRetentionMaximumEstimatedRetainedBytes": 0,
    "SnapshotRetentionFreeSpacePath": null,
    "SnapshotRetentionMinimumFreeBytes": 0,
    "MetadataTtlCleanupEnabled": true,
    "MetadataRetentionDays": 180,
    "MetadataCleanupBatchSize": 5000,
    "MetadataCleanupMaxBatches": 1,
    "CompletedScrapeLogRowsToKeep": 100,
    "DeferredServiceLevelRetentionEnabled": true,
    "DeferredServiceLevelRetentionInitialDelaySeconds": 60,
    "DeferredServiceLevelRetentionPollSeconds": 60,
    "DeferredServiceLevelRetentionMaxAttempts": 30,
    "DeferredServiceLevelRetentionMaxRuntimeMinutes": 90,
    "LongRunningMaintenanceSeconds": 30,
    "WatchedTableDeadTupleThreshold": 10000000,
    "WatchedTables": [
      "leaderboard_entries_snapshot",
      "band_team_rank_history",
      "band_team_rank_history_points",
      "band_team_ranking_stats_history",
      "composite_rank_history",
      "rank_history"
    ]
  },

  "BackgroundJobs": {
    "StopBeforeNextScrapeMinutes": 5,
    "MaxGracefulStopSeconds": 30,
    "PauseBestEffortOnScrapeStart": true,
    "MaxDbConnections": 1
  },

  "Api": {
    "ApiKey": "",
    "AllowedOrigins": [ "http://localhost:3000" ]
  },

  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080"
      }
    }
  },

  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5432;Database=fstservice;Username=fst;Password=;Minimum Pool Size=2;Maximum Pool Size=15;Connection Idle Lifetime=30;Connection Pruning Interval=10;Command Timeout=0"
  }
}
