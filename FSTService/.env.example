# FSTService local development secrets
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.
#
# Variable names use __ (double underscore) as the section separator,
# which ASP.NET Core maps to the corresponding appsettings.json path.

# Service and worker credentials (required; no tracked defaults)
Api__ApiKey=
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=
