[Unit]
Description=FST snapshot-generation archive retirement (network-bound fetch windows only)
Documentation=file:///mnt/docker-storage/Docker/FestivalServiceTracker/fst-data/ops/snapshot-retire-checkout/docs/database/SnapshotGenerationArchiveRetirementRunbook.md

[Service]
Type=oneshot
# A git worktree of this repository detached at the accepted master commit.
WorkingDirectory=/mnt/docker-storage/Docker/FestivalServiceTracker/fst-data/ops/snapshot-retire-checkout
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 tools/postgres-snapshot-archive-retire.py auto
Nice=10
# One run retires at most one cycle and ends when the fetch window closes.
TimeoutStartSec=4h
