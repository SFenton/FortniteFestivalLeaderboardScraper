# Optional runtime routing for hosts that keep the live Compose project outside
# this repository checkout. When set, deploy/fst-compose.sh runs Docker Compose
# from this directory instead of from deploy/.
#
# FST_DEPLOY_COMPOSE_DIR=/home/sfenton/Docker/FestivalServiceTracker

# Required when deploy/ is used directly as the runtime Compose directory.
# Never commit real values.
PG_PASSWORD=
API_KEY=

# Required Epic OAuth client credentials. FSTService has no tracked defaults.
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=

# Optional path generation and host integration.
MIDI_ENCRYPTION_KEY=
DOCKER_GID=999
FST_DATA_DIR=./fst-data
POSTGRES_DATA_DIR=./pg-data

# Optional App Manual exposure.
FEATURE_APP_MANUAL=false

# Optional four-endpoint AirVPN profile. Populate only when starting the
# `vpn` Compose profile; every numbered endpoint needs its own device identity.
GLUETUN_1_WG_PRIVATE_KEY=
GLUETUN_1_WG_PRESHARED_KEY=
GLUETUN_1_WG_ADDRESS=
GLUETUN_1_CITY=
GLUETUN_2_WG_PRIVATE_KEY=
GLUETUN_2_WG_PRESHARED_KEY=
GLUETUN_2_WG_ADDRESS=
GLUETUN_2_CITY=
GLUETUN_3_WG_PRIVATE_KEY=
GLUETUN_3_WG_PRESHARED_KEY=
GLUETUN_3_WG_ADDRESS=
GLUETUN_3_CITY=
GLUETUN_4_WG_PRIVATE_KEY=
GLUETUN_4_WG_PRESHARED_KEY=
GLUETUN_4_WG_ADDRESS=
GLUETUN_4_CITY=
AIRVPN_WG_PUBLIC_KEY=

# Snapshot partition rewrites are destructive maintenance and stay disabled
# until an explicitly monitored live-scrape parity window promotes them.
DATABASE_MAINTENANCE_SNAPSHOT_RETENTION_REWRITE_ENABLED=false
DATABASE_MAINTENANCE_SNAPSHOT_RETENTION_FREE_SPACE_PATH=/app/data
DATABASE_MAINTENANCE_SNAPSHOT_RETENTION_MINIMUM_FREE_BYTES=0
