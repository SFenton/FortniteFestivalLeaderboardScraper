# Optional runtime routing for hosts that keep the live Compose project outside
# this repository checkout. When set, deploy/fst-compose.sh runs Docker Compose
# from this directory instead of from deploy/.
#
# FST_DEPLOY_COMPOSE_DIR=/home/sfenton/Docker/FestivalServiceTracker

# Required when deploy/ is used directly as the runtime Compose directory.
# Never commit real values.
PG_PASSWORD=
API_KEY=

# Snapshot partition rewrites are destructive maintenance and stay disabled
# until an explicitly monitored live-scrape parity window promotes them.
DATABASE_MAINTENANCE_SNAPSHOT_RETENTION_REWRITE_ENABLED=false
DATABASE_MAINTENANCE_SNAPSHOT_RETENTION_FREE_SPACE_PATH=/app/data
DATABASE_MAINTENANCE_SNAPSHOT_RETENTION_MINIMUM_FREE_BYTES=0
