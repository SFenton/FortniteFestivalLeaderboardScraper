# Safe API-service role defaults. Compose environment entries still override
# these values explicitly when a gated rollout requires it.
Scraper__SkipStartupSchemaInitialization=false
Scraper__EnableAutomaticPathGeneration=false
Features__WritePublishedScopeSources=false
Features__UsePublishedScopeSources=true
Features__SkipUnchangedPhysicalLeaderboardSnapshots=false
Features__EnablePublicationReadContext=false
