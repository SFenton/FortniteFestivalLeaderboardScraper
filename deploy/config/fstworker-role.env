# Safe worker role defaults. Candidate overlays may override independently
# reversible values only after their declared scrape/parity gate.
Scraper__SkipStartupSchemaInitialization=true
Scraper__RunOnce=false
# Legacy API-owned automatic generation stays rejected at startup. The
# publication-safe scrape-pass generator below replaces it; the supported
# production configuration never leaves the catalog without a generator.
# The deployment must provide a valid Scraper__MidiEncryptionKey through its
# secret environment; startup fails before readiness when it is absent/invalid.
Scraper__EnableAutomaticPathGeneration=false
Scraper__UsePublicationPathArtifacts=true
Scraper__EnableScrapePassPathGeneration=true
# Bounded per-pass staging budget. Changed existing maxima stay blocked for
# max-score maintenance review.
Scraper__ScrapePassPathGenerationMaxSongs=25
Scraper__ScrapePassPathGenerationTimeout=00:20:00
Scraper__ScrapePassPathGenerationAllowChangedMaxima=false
Features__EnforceScopeCompletenessManifests=true
Features__RequireSuccessfulScrapeWriters=true
Features__EnforcePublicationCriticalPhases=true
Features__WritePublishedScopeSources=true
Features__UsePublishedScopeSources=false
Features__UseLeaderboardScopeFingerprints=true
Features__SkipUnchangedPhysicalLeaderboardSnapshots=true
Features__EnablePublicationReadContext=false
Features__WriteLegacyLiveLeaderboardDuringScrape=false
