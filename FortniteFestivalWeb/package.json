{
  "name": "fortnite-festival-web",
  "private": true,
  "version": "0.1.130",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "yarn theme:css:check && tsc -b && vite build && node scripts/ensure-embedded-compatibility-assets.mjs",
    "preview": "vite preview",
    "test": "yarn test:unit",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:coverage": "node scripts/run-unit-coverage.mjs",
    "test:shared": "node scripts/run-shared-tests.mjs",
    "test:shared:coverage": "node scripts/run-shared-tests.mjs --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:typecheck": "tsc -p tsconfig.e2e.json",
    "e2e:ci": "yarn e2e:ci:core && yarn e2e:ci:wide && yarn e2e:ci:webkit && yarn e2e:ci:component && yarn e2e:ci:publication",
    "e2e:ci:core": "yarn e2e:ci:desktop && yarn e2e:ci:mobile",
    "e2e:ci:desktop": "node scripts/run-e2e-project.mjs chromium-desktop",
    "e2e:ci:mobile": "node scripts/run-e2e-project.mjs chromium-mobile",
    "e2e:ci:wide": "playwright test --project=chromium-wide --workers=2",
    "e2e:ci:webkit": "playwright test --project=webkit-mobile --workers=1",
    "e2e:ci:component": "playwright test --config=playwright.component.config.ts --project=ct-chromium --workers=2",
    "e2e:ci:publication": "playwright test --config=playwright.publication.config.ts --workers=1",
    "e2e:nightly": "playwright test --project=webkit-desktop --project=firefox-desktop --workers=2 && playwright test --config=playwright.component.config.ts --project=ct-webkit --project=ct-firefox --workers=2",
    "e2e:component": "playwright test --config=playwright.component.config.ts --project=ct-chromium",
    "e2e:publication": "playwright test --config=playwright.publication.config.ts",
    "e2e:headed": "playwright test --headed",
    "lint": "eslint src/",
    "lint:css": "stylelint 'src/**/*.module.css'",
    "manual:screenshots": "node scripts/generate-manual-screenshots.cjs && node scripts/generate-manual-image-variants.mjs",
    "manual:images": "node scripts/generate-manual-image-variants.mjs",
    "manual:images:check": "node scripts/generate-manual-image-variants.mjs --check",
    "embedded:check": "node scripts/verify-embedded-bundle.mjs",
    "performance:manual": "node scripts/capture-manual-performance.mjs",
    "performance:suggestions": "SUGGESTIONS_BENCHMARK=1 playwright test e2e/specs/performance/suggestions-long-scroll.spec.ts --project=chromium-desktop --workers=1",
    "icons:generate": "node scripts/generate-pwa-icons.mjs",
    "licenses:generate": "node ../tools/generate-license-manifest.mjs",
    "licenses:check": "node ../tools/generate-license-manifest.mjs --check",
    "theme:css:generate": "node scripts/generate-theme-css.mjs",
    "theme:css:check": "node scripts/generate-theme-css.mjs --check",
    "check:coverage-ignores": "node --test ../tools/check-coverage-ignores.test.mjs && node scripts/check-coverage-ignores.mjs",
    "check:encoding": "node ../tools/check-encoding.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@festival/core": "portal:../packages/core",
    "@festival/theme": "portal:../packages/theme",
    "@festival/ui-utils": "portal:../packages/ui-utils",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-virtual": "^3.13.22",
    "i18next": "^25.8.18",
    "katex": "^0.16.44",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^16.5.8",
    "react-icons": "^5.6.0",
    "react-is": "^19.2.4",
    "react-router-dom": "^7.1.0",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-is": "^19",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "4.0.18",
    "axe-core": "^4.12.1",
    "eslint": "^10.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "jsdom": "^28.1.0",
    "stylelint": "^17.5.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.11.1",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.57.1",
    "vite": "^6.2.0",
    "vitest": "^4.0.18"
  },
  "packageManager": "yarn@4.12.0+sha512.f45ab632439a67f8bc759bf32ead036a1f413287b9042726b7cc4818b7b49e14e9423ba49b18f9e06ea4941c1ad062385b1d8760a8d5091a1a31e5f6219afca8"
}
